{
    "name": "pobo-builder/php-sdk",
    "description": "Official PHP SDK for Pobo API V2 - product content management and webhooks",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "pobo",
        "api",
        "sdk",
        "ecommerce",
        "product-content"
    ],
    "homepage": "https://github.com/pobo-builder/php-sdk",
    "authors": [
        {
            "name": "Tomas Smetka",
            "email": "tomas@pobo.cz",
            "homepage": "https://pobo.space"
        }
    ],
    "support": {
        "issues": "https://github.com/pobo-builder/php-sdk/issues",
        "source": "https://github.com/pobo-builder/php-sdk"
    },
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^2.1",
        "fakerphp/faker": "^1.23"
    },
    "autoload": {
        "psr-4": {
            "Pobo\\Sdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pobo\\Sdk\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
